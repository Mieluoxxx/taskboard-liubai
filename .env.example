# Supabase project URL, exposed to the browser by Vite.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Prefer the publishable key. Legacy anon is accepted for older projects.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server only. Match private.agent_config.resource_url; never prefix the secret with VITE_.
TASKBOARD_MCP_URL=https://taskboard-liubai.vercel.app/api/mcp
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TASKBOARD_MCP_SECRET=
# Optional comma-separated browser origins for browser-hosted MCP clients.
TASKBOARD_MCP_ORIGINS=
