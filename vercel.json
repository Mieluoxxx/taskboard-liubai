{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/mcp.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/oauth/consent", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth-protected-resource" },
    { "source": "/.well-known/oauth-protected-resource/api/mcp", "destination": "/api/oauth-protected-resource" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
